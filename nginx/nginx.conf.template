server {
    listen 80;
    server_name _;

    resolver 127.0.0.11 valid=30s;

    set $money_backend    ${MONEY_BACKEND};
    set $backup_backend   ${BACKUP_BACKEND};
    set $home_api_backend ${HOME_API_BACKEND};

    # ── Python web apps ──────────────────────────────────────────────────────

    location /wordhelper/ {
        set $upstream_wordhelper wordhelper:8080;
        proxy_pass         http://$upstream_wordhelper/;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_set_header   X-Forwarded-Prefix  /wordhelper;
    }

    location /wordclue/ {
        set $upstream_wordclue wordclue:8080;
        proxy_pass         http://$upstream_wordclue/;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_set_header   X-Forwarded-Prefix  /wordclue;
    }

    location /home/ {
        set $upstream_home home:8080;
        proxy_pass         http://$upstream_home/;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_set_header   X-Forwarded-Prefix  /home;
    }

    # ── Backend APIs ─────────────────────────────────────────────────────────

    location /money/docs/ {
        proxy_pass         http://$money_backend/;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   Accept-Encoding     "";
        sub_filter_once    off;
        sub_filter_types   *;
        sub_filter         '"/v3/api-docs'     '"/money/docs/v3/api-docs';
    }

    location /backup/docs/ {
        proxy_pass         http://$backup_backend/;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   Accept-Encoding     "";
        sub_filter_once    off;
        sub_filter_types   *;
        sub_filter         '"/v3/api-docs'     '"/backup/docs/v3/api-docs';
    }

    location /home/docs/ {
        proxy_pass         http://$home_api_backend/;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   Accept-Encoding     "";
        sub_filter_once    off;
        sub_filter_types   *;
        sub_filter         '"/v3/api-docs'     '"/home/docs/v3/api-docs';
    }

    location /money/ {
        proxy_pass         http://$money_backend/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 3600s;
    }

    location /backup/ {
        proxy_pass         http://$backup_backend/api/v1/;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 3600s;
    }

    # ── Angular SPA (catch-all — must be last) ───────────────────────────────

    location / {
        set $upstream_webpage webpage:80;
        proxy_pass         http://$upstream_webpage;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
    }
}
