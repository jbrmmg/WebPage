server {
    listen 80;
    server_name _;

    resolver 127.0.0.11 valid=30s;

    set $backup_backend backup:8080;
    set $money_backend  money:8080;

    # ── Python web apps ──────────────────────────────────────────────────────

    location /wordhelper/ {
        set $upstream_wordhelper wordhelper:8080;
        rewrite            ^/wordhelper/(.*)    /$1 break;
        proxy_pass         http://$upstream_wordhelper;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_set_header   X-Forwarded-Prefix  /wordhelper;
    }

    location /wordclue/ {
        set $upstream_wordclue wordclue:8080;
        rewrite            ^/wordclue/(.*)      /$1 break;
        proxy_pass         http://$upstream_wordclue;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_set_header   X-Forwarded-Prefix  /wordclue;
    }

    location /connections/ {
        set $upstream_connections connections:8080;
        rewrite            ^/connections/(.*)   /$1 break;
        proxy_pass         http://$upstream_connections;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_set_header   X-Forwarded-Prefix  /connections;
    }

    location /home/ {
        set $upstream_home home:8080;
        rewrite            ^/home/(.*)          /$1 break;
        proxy_pass         http://$upstream_home;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_set_header   X-Forwarded-Prefix  /home;
    }

    # ── Backend APIs ─────────────────────────────────────────────────────────

    location = /money/report {
        return 301 /money/report/;
    }

    location /money/report/ {
        set $upstream_moneyreport money:8081;
        rewrite            ^/money/report/(.*)  /$1 break;
        proxy_pass         http://$upstream_moneyreport;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_set_header   X-Forwarded-Prefix  /money/report;
    }

    location /money/docs/ {
        rewrite            ^/money/docs(/.*)?$  $1 break;
        proxy_pass         http://$money_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Prefix  /money;
        proxy_set_header   Accept-Encoding     "";
        sub_filter_once    off;
        sub_filter_types   *;
        sub_filter         '"/money/v3/api-docs' '"/money/docs/v3/api-docs';
    }

    location /backup/docs/ {
        rewrite            ^/backup/docs(/.*)?$ $1 break;
        proxy_pass         http://$backup_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Prefix  /backup;
        proxy_set_header   Accept-Encoding     "";
        sub_filter_once    off;
        sub_filter_types   *;
        sub_filter         '"/backup/v3/api-docs' '"/backup/docs/v3/api-docs';
    }

    location /home/docs/ {
        set $home_api_backend home:8080;
        rewrite            ^/home/docs(/.*)?$   $1 break;
        proxy_pass         http://$home_api_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   Accept-Encoding     "";
        sub_filter_once    off;
        sub_filter_types   *;
        sub_filter         '"/v3/api-docs'     '"/home/docs/v3/api-docs';
    }

    location /money/api/v1/ {
        rewrite            ^/money(/.*)$        $1 break;
        proxy_pass         http://$money_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 3600s;
    }

    location /money/ {
        rewrite            ^/money(/.*)?$       /api/v1$1 break;
        proxy_pass         http://$money_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 3600s;
    }

    location /backup/api/v1/ {
        rewrite            ^/backup(/.*)$       $1 break;
        proxy_pass         http://$backup_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 3600s;
    }

    location /backup/ {
        rewrite            ^/backup(/.*)?$      /api/v1$1 break;
        proxy_pass         http://$backup_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 3600s;
    }

    # ── Recipe (UI + API in single container) ───────────────────────────────

    location /recipe/docs/ {
        set $recipe_backend recipe:8080;
        rewrite            ^/recipe/docs(/.*)?$ $1 break;
        proxy_pass         http://$recipe_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Prefix  /recipe;
        proxy_set_header   Accept-Encoding     "";
        sub_filter_once    off;
        sub_filter_types   *;
        sub_filter         '"/recipe/v3/api-docs' '"/recipe/docs/v3/api-docs';
    }

    location /recipe/api/ {
        set $recipe_backend recipe:8080;
        rewrite            ^/recipe(/.*)$       $1 break;
        proxy_pass         http://$recipe_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 3600s;
    }

    location /recipe/ {
        set $recipe_backend recipe:8080;
        rewrite            ^/recipe/?(.*)$      /$1 break;
        proxy_pass         http://$recipe_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
    }

    # ── Angular SPA (catch-all — must be last) ───────────────────────────────

    location / {
        set $upstream_webpage webpage:80;
        proxy_pass         http://$upstream_webpage;
        proxy_http_version 1.1;
        proxy_set_header   Host                $host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
    }
}
